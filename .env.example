# Bender Configuration File
# Copy this to .env and modify as needed

# VersionOne API Configuration
V1_INSTANCE=https://www11.v1host.com/VersionOneMi
V1_USERNAME=your_username
V1_PASSWORD=your_password

# System Configuration
AUTOTEST=true
POLL_TIME=5
LOG_LEVEL=INFO

# GPIO Pin Configuration (Raspberry Pi)
TRIG_PIN=16
ECHO_PIN=18
FORWARD_PIN=12
REVERSE_PIN=11
LEFT_PIN=13
RIGHT_PIN=15

# Physical Configuration
ORIGIN_DISTANCE=15.0